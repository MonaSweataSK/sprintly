generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(120)
  email           String         @unique @db.VarChar(254)
  role            UserRole       @default(USER)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  otpChallenges   OTPChallenge[]
  sessions        UserSession[]
  teamMemberships TeamMember[]
  createdSprints  Sprint[]
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")

  @@map("users")
}

model OTPChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("otp_challenges")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(120)
  description String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  members     TeamMember[]
  sprints     Sprint[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Sprint {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(160)
  description String?      @db.VarChar(2000)
  teamId      String?      @map("team_id") @db.Uuid
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  status      SprintStatus @default(PLANNED)
  createdById String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([status, startDate, endDate])
  @@index([teamId, status])
  @@map("sprints")
}

model Task {
  id            String           @id @default(uuid()) @db.Uuid
  taskKey       String           @unique @default(dbgenerated("('TASK-'::text || nextval('task_key_seq'::regclass)::text)")) @map("task_key") @db.VarChar(32)
  title         String           @db.VarChar(240)
  description   String?          @db.VarChar(10000)
  assigneeId    String?          @map("assignee_id") @db.Uuid
  sprintId      String?          @map("sprint_id") @db.Uuid
  startDate     DateTime?        @map("start_date") @db.Date
  endDate       DateTime?        @map("end_date") @db.Date
  status        TaskStatus       @default(TODO)
  createdById   String?          @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sprint        Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  prerequisites TaskDependency[] @relation("TaskPrerequisites")
  dependents    TaskDependency[] @relation("TaskDependents")

  @@index([sprintId, status])
  @@index([assigneeId])
  @@index([createdAt])
  @@map("tasks")
}

model TaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  task            Task     @relation("TaskPrerequisites", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}
